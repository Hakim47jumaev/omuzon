[Unit]
Description=gunicorn daemon for Omuzon API
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/omuzon/API
Environment="PATH=/var/www/omuzon/API/.venv/bin"
ExecStart=/var/www/omuzon/API/.venv/bin/gunicorn \
    --config /var/www/omuzon/API/gunicorn_config.py \
    core.wsgi:application
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
